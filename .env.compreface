TZ=Asia/Shanghai

# Network and volume
COMPREFACE_NETWORK_NAME=ssk-compreface-net
COMPREFACE_POSTGRES_VOLUME=compreface-120_postgres-data

# CompreFace UI published port
COMPREFACE_UI_PORT=8002

# CompreFace images
registry=exadel/
POSTGRES_VERSION=1.2.0
ADMIN_VERSION=1.2.0
API_VERSION=1.2.0
FE_VERSION=1.2.0
CORE_VERSION=1.2.0

# PostgreSQL for CompreFace
postgres_username=postgres
postgres_password=postgres
postgres_db=frs
postgres_domain=compreface-postgres-db
postgres_port=5432

# Runtime tuning
save_images_to_db=true
max_file_size=5MB
max_request_size=10M
max_detect_size=320
read_timeout=60000
connection_timeout=10000
enable_email_server=false
email_host=
email_username=
email_from=
email_password=
compreface_api_java_options=-Xms256m -Xmx4g
compreface_admin_java_options=-Xms128m -Xmx256m
uwsgi_processes=1
uwsgi_threads=1
COMPREFACE_CORE_CPUS=1.0
compreface_core_omp_threads=1
compreface_core_openblas_threads=1
compreface_core_mkl_threads=1
compreface_core_numexpr_threads=1
compreface_core_veclib_threads=1
compreface_core_kmp_blocktime=0
