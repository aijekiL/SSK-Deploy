TZ=Asia/Shanghai

# Compose profiles
# main: mysql/mongodb/redis/zlmediakit/caps/netcore/manage-frontend
# compreface: compreface-postgres-db/compreface-core/compreface-api/compreface-admin/compreface-fe

# Network and volume names
MAIN_NETWORK_NAME=ssk-main-net
COMPREFACE_NETWORK_NAME=ssk-compreface-net
COMPREFACE_POSTGRES_VOLUME=compreface-120_postgres-data

# MySQL
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=123456
CAPS_DB_NAME=ry-zhdj
CAPS_DB_USER=root
CAPS_DB_PASSWORD=123456
SSK_DB_NAME=aqjc_manage_system
SSK_DB_USER=root
SSK_DB_PASSWORD=123456

# MongoDB / Redis
MONGO_PORT=27017
REDIS_PORT=6379
REDIS_PASSWORD=123456
SSK_USE_REDIS=false

# Main app ports
CAPS_PORT=5010
SSK_PORT=9991
MANAGE_FRONTEND_PORT=3000

# ZLMediaKit
ZLM_IMAGE=zl:transcode
ZLM_RTMP_PORT=1935
ZLM_HTTP_PORT=8081
ZLM_HTTPS_PORT=8949
ZLM_RTSP_PORT=8554
ZLM_RTP_PROXY_TCP_PORT=10000
ZLM_RTP_PROXY_UDP_PORT=10000
ZLM_RTP_SERVER_PORT=8000
ZLM_WEBRTC_UDP_PORT=9000
RTMP_URL=192.168.166.210

# CompreFace access for SSK backend
# Unified compose defaults to the internal service name.
# If CompreFace is deployed elsewhere, override this with the external URL.
COMPREFACE_BASE_URL=http://compreface-fe
COMPREFACE_RECOGNITION_PATH=/api/v1/recognition
SSK_COMPREFACE_API_KEY=2f8191f6-02a5-4dd5-821b-4a50aea1572d

# CompreFace UI published port
COMPREFACE_UI_PORT=8001

# CompreFace images
registry=exadel/
POSTGRES_VERSION=1.2.0
ADMIN_VERSION=1.2.0
API_VERSION=1.2.0
FE_VERSION=1.2.0
CORE_VERSION=1.2.0

# PostgreSQL for CompreFace
postgres_username=postgres
postgres_password=postgres
postgres_db=frs
postgres_domain=compreface-postgres-db
postgres_port=5432

# Runtime tuning
save_images_to_db=true
max_file_size=5MB
max_request_size=10M
max_detect_size=640
read_timeout=60000
connection_timeout=10000
enable_email_server=false
email_host=
email_username=
email_from=
email_password=
compreface_api_java_options=-Xms128m -Xmx256m
compreface_admin_java_options=-Xms128m -Xmx256m
uwsgi_processes=1
uwsgi_threads=1
