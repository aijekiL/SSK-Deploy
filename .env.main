TZ=Asia/Shanghai

# Network name for the main stack
MAIN_NETWORK_NAME=ssk-main-net

# MySQL
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=123456
CAPS_DB_NAME=ry-zhdj
CAPS_DB_USER=root
CAPS_DB_PASSWORD=123456
SSK_DB_NAME=aqjc_manage_system
SSK_DB_USER=root
SSK_DB_PASSWORD=123456

# MongoDB / Redis
MONGO_PORT=27017
REDIS_PORT=6379
REDIS_PASSWORD=123456
SSK_USE_REDIS=false

# App ports
CAPS_PORT=5010
WATCH_TCP_PORT=5011
SSK_PORT=9991
MANAGE_FRONTEND_PORT=3001
MANAGE_FRONTEND_HTTPS_PORT=3000

# ZLMediaKit
ZLM_IMAGE=zl:transcode
ZLM_RTMP_PORT=1935
ZLM_HTTP_PORT=8081
ZLM_HTTPS_PORT=8949
ZLM_RTSP_PORT=8554
ZLM_RTP_PROXY_TCP_PORT=10000
ZLM_RTP_PROXY_UDP_PORT=10000
ZLM_RTP_SERVER_PORT=8000
ZLM_WEBRTC_UDP_PORT=9000
RTMP_URL=192.168.144.52
WEBRTC_URL=https://192.168.144.52:3000/zlm

# CAPS stream recovery strategy (milliseconds)
CAPS_STREAM_STARTING_GRACE_MS=40000
CAPS_STREAM_LOST_GRACE_MS=40000
CAPS_STREAM_OPEN_RTSP_MIN_INTERVAL_MS=60000
CAPS_STREAM_FAILED_RESTART_DELAY_MS=5000
CAPS_STREAM_AUTO_RESTART_RESET_MS=300000
CAPS_STREAM_AUTO_RESTART_LIMIT=1

# External CompreFace endpoint
# Same Docker Desktop host: http://host.docker.internal:8001
# Remote host example: http://192.168.1.50:8001
COMPREFACE_BASE_URL=http://host.docker.internal:8002
COMPREFACE_RECOGNITION_PATH=/api/v1/recognition
SSK_COMPREFACE_API_KEY=0bef00f6-7711-4168-bb99-eb66d7f9a6f6
