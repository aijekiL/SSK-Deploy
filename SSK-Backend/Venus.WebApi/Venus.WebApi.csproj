    <ProjectReference Include="..\Venus.Entitys\Venus.Entitys.csproj" />
    <ProjectReference Include="..\Venus.IService\Venus.IService.csproj" />
    <ProjectReference Include="..\Venus.Jobs\Venus.Jobs.csproj" />
    <ProjectReference Include="..\Venus.Service\Venus.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

