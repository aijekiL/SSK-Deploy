<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.system.mapper.CapsDeviceAlarmMapper">
    
    <resultMap type="CapsDeviceAlarm" id="CapsDeviceAlarmResult">
        <result property="id"    column="id"    />
        <result property="deviceId"    column="device_id"    />
        <result property="type"    column="type"    />
        <result property="typeInfo"    column="type_info"    />
        <result property="xPoint"    column="x_point"    />
        <result property="yPoint"    column="y_point"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectCapsDeviceAlarmVo">
        select id, device_id, type, type_info, x_point, y_point, create_by, create_time, update_by, update_time, remark from caps_device_alarm
    </sql>

    <select id="selectCapsDeviceAlarmList" parameterType="CapsDeviceAlarm" resultMap="CapsDeviceAlarmResult">
        <include refid="selectCapsDeviceAlarmVo"/>
        <where>  
            <if test="deviceId != null  and deviceId != ''"> and device_id = #{deviceId}</if>
            <if test="type != null "> and type = #{type}</if>
            <if test="typeInfo != null  and typeInfo != ''"> and type_info = #{typeInfo}</if>
            <if test="xPoint != null  and xPoint != ''"> and x_point = #{xPoint}</if>
            <if test="yPoint != null  and yPoint != ''"> and y_point = #{yPoint}</if>
        </where>
    </select>
    
    <select id="selectCapsDeviceAlarmById" parameterType="Integer" resultMap="CapsDeviceAlarmResult">
        <include refid="selectCapsDeviceAlarmVo"/>
        where id = #{id}
    </select>

    <insert id="insertCapsDeviceAlarm" parameterType="CapsDeviceAlarm" useGeneratedKeys="true" keyProperty="id">
        insert into caps_device_alarm
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deviceId != null">device_id,</if>
            <if test="type != null">type,</if>
            <if test="typeInfo != null">type_info,</if>
            <if test="xPoint != null">x_point,</if>
            <if test="yPoint != null">y_point,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deviceId != null">#{deviceId},</if>
            <if test="type != null">#{type},</if>
            <if test="typeInfo != null">#{typeInfo},</if>
            <if test="xPoint != null">#{xPoint},</if>
            <if test="yPoint != null">#{yPoint},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateCapsDeviceAlarm" parameterType="CapsDeviceAlarm">
        update caps_device_alarm
        <trim prefix="SET" suffixOverrides=",">
            <if test="deviceId != null">device_id = #{deviceId},</if>
            <if test="type != null">type = #{type},</if>
            <if test="typeInfo != null">type_info = #{typeInfo},</if>
            <if test="xPoint != null">x_point = #{xPoint},</if>
            <if test="yPoint != null">y_point = #{yPoint},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCapsDeviceAlarmById" parameterType="Integer">
        delete from caps_device_alarm where id = #{id}
    </delete>

    <delete id="deleteCapsDeviceAlarmByIds" parameterType="String">
        delete from caps_device_alarm where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>