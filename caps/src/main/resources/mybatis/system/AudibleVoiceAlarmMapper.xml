<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.system.mapper.AudibleVoiceAlarmMapper">

    <resultMap type="AudibleVoiceAlarm" id="AudibleVoiceAlarmResult">
        <result property="id"    column="id"    />
        <result property="deviceCode"    column="device_code"    />
        <result property="personId"    column="person_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectAudibleVoiceAlarmVo">
        select id, device_code, person_id, create_by, create_time, update_by, update_time, remark from audible_voice_alarm
    </sql>

    <select id="selectAudibleVoiceAlarmList" parameterType="AudibleVoiceAlarm" resultMap="AudibleVoiceAlarmResult">
        <include refid="selectAudibleVoiceAlarmVo"/>
        <where>
            <if test="deviceCode != null  and deviceCode != ''"> and device_code = #{deviceCode}</if>
            <if test="personId != null  and personId != ''"> and person_id = #{personId}</if>
        </where>
    </select>

    <select id="selectAudibleVoiceAlarmById" parameterType="Integer" resultMap="AudibleVoiceAlarmResult">
        <include refid="selectAudibleVoiceAlarmVo"/>
        where id = #{id}
    </select>

    <insert id="insertAudibleVoiceAlarm" parameterType="AudibleVoiceAlarm" useGeneratedKeys="true" keyProperty="id">
        insert into audible_voice_alarm
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deviceCode != null and deviceCode != ''">device_code,</if>
            <if test="personId != null and personId != ''">person_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deviceCode != null and deviceCode != ''">#{deviceCode},</if>
            <if test="personId != null and personId != ''">#{personId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateAudibleVoiceAlarm" parameterType="AudibleVoiceAlarm">
        update audible_voice_alarm
        <trim prefix="SET" suffixOverrides=",">
            <if test="deviceCode != null and deviceCode != ''">device_code = #{deviceCode},</if>
            <if test="personId != null and personId != ''">person_id = #{personId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAudibleVoiceAlarmById" parameterType="Integer">
        delete from audible_voice_alarm where id = #{id}
    </delete>

    <delete id="deleteAudibleVoiceAlarmByIds" parameterType="String">
        delete from audible_voice_alarm where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectAudibleVoiceAlarmByCode" parameterType="String" resultMap="AudibleVoiceAlarmResult">
        <include refid="selectAudibleVoiceAlarmVo"/>
        where device_code = #{deviceCode}
    </select>
</mapper>
