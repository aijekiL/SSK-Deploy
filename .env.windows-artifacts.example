TZ=Asia/Shanghai

# MySQL
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=123456
CAPS_DB_NAME=ry-zhdj
CAPS_DB_USER=root
CAPS_DB_PASSWORD=123456
SSK_DB_NAME=aqjc_manage_system
SSK_DB_USER=root
SSK_DB_PASSWORD=123456

# MongoDB / Redis
MONGO_PORT=27017
REDIS_PORT=6379
REDIS_PASSWORD=123456
SSK_USE_REDIS=false

# App ports
CAPS_PORT=5010
SSK_PORT=9991
MANAGE_FRONTEND_PORT=3000
COMPREFACE_UI_PORT=8001

# ZLMediaKit
ZLM_IMAGE=zl:transcode
ZLM_RTMP_PORT=1935
ZLM_HTTP_PORT=8081
ZLM_HTTPS_PORT=8949
ZLM_RTSP_PORT=8554
ZLM_RTP_PROXY_TCP_PORT=10000
ZLM_RTP_PROXY_UDP_PORT=10000
ZLM_RTP_SERVER_PORT=8000
ZLM_WEBRTC_UDP_PORT=9000
RTMP_URL=zlmediakit

# CompreFace
registry=exadel/
POSTGRES_VERSION=1.2.0
ADMIN_VERSION=1.2.0
API_VERSION=1.2.0
FE_VERSION=1.2.0
CORE_VERSION=1.2.0
postgres_username=postgres
postgres_password=postgres
postgres_db=frs
postgres_domain=compreface-postgres-db
postgres_port=5432
# Reuse standalone CompreFace data volume by default
COMPREFACE_POSTGRES_VOLUME=compreface-120_postgres-data
save_images_to_db=true
max_file_size=5MB
max_request_size=10M
max_detect_size=640
read_timeout=60000
connection_timeout=10000
enable_email_server=false
email_host=
email_username=
email_from=
email_password=
compreface_api_java_options=-Xms256m -Xmx512m
compreface_admin_java_options=-Xms256m -Xmx512m
uwsgi_processes=2
uwsgi_threads=1

# SSK -> CompreFace (set this to the recognition API key generated in CompreFace UI)
SSK_COMPREFACE_API_KEY=37d5d9ca-6c7c-4729-b98f-02a4a88dc653
